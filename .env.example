# GPU Observability - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then run:
#   ./setup.sh --env .env

# GCP Configuration (required)
PROJECT_ID=your-gcp-project-id
ZONE=us-central1-a
CLUSTER_NAME=nim-demo
NODE_POOL_MACHINE_TYPE=g2-standard-4
NUM_NODES=1

# GPU Configuration
GPU_TYPE=nvidia-l4
GPU_COUNT=1

# Hugging Face token (leave blank to be prompted securely at runtime)
HF_TOKEN=

# Options: Y or N
DISABLE_DCGM=N
DEPLOY_MONITORING=Y
DEPLOY_DASHBOARDS=Y
